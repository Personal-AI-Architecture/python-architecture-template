{
  "name": "python-architecture-template",
  "language": "python",
  "root": ".",
  "live": { "start": "python scripts/run_server.py --host $PAA_HOST --port $PAA_PORT", "preference_path": "/owner/preferences" },
  "contracts": {
    "lock_file": "paa.lock.json"
  },
  "commands": [
    {
      "name": "typecheck",
      "command": "python -m mypy src"
    },
    {
      "name": "syntax",
      "command": "python -m compileall -q src scripts tests"
    },
    {
      "name": "unit",
      "command": "python -m unittest discover -s tests/unit -p 'test_*.py'"
    },
    {
      "name": "integration",
      "command": "python -m unittest discover -s tests/integration -p 'test_*.py'"
    },
    {
      "name": "conformance",
      "command": "python -m unittest discover -s tests/conformance -p 'test_*.py'"
    },
    {
      "name": "acceptance",
      "command": "python scripts/acceptance_check.py"
    }
  ]
}
